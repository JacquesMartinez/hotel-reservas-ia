# Copia este archivo como .env y completa los valores de tu entorno local.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# Conexión a MySQL
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Puerto de la app Flask (en macOS el 5000 lo usa AirPlay Receiver)
PORT=5000
