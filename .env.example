# Copia este archivo como .env y completa los valores de tu entorno local.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# Conexión a MySQL
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave para firmar la cookie de sesión. Obligatoria: la app no arranca sin ella.
# Genera una propia con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Puerto de la app Flask (en macOS el 5000 lo usa AirPlay Receiver)
PORT=5000
